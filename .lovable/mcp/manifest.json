{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://oauth-issuer-unset.invalid",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "lifters-touch-mcp",
      "version": "0.3.0",
      "title": "Lifter's Touch MCP"
    },
    "tools": [
      {
        "name": "echo",
        "title": "Echo",
        "description": "Echo the input text back to the caller to verify MCP connectivity.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "description": "Text to echo back."
            }
          },
          "required": [
            "text"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_members",
        "title": "List members",
        "description": "List members from the Laravel backend. Results are scoped by the caller's branch and role via the same policies used by the web UI.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "search": {
              "description": "Optional name/ID search string.",
              "type": "string",
              "minLength": 1
            },
            "status": {
              "description": "Filter by member status.",
              "type": "string",
              "enum": [
                "pending",
                "active",
                "suspended",
                "terminated"
              ]
            },
            "branch_id": {
              "description": "Filter by branch (cross-branch roles only).",
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "page": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "per_page": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_member",
        "title": "Get member",
        "description": "Fetch a single member by id. Branch-scoped by policy.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "member_id": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "description": "Member primary key."
            }
          },
          "required": [
            "member_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_disbursements",
        "title": "List disbursements",
        "description": "List disbursement requests. Branch-scoped: non-privileged callers only see their own branch's records.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "stage": {
              "description": "Filter by workflow stage.",
              "type": "string",
              "enum": [
                "DRAFT",
                "SUBMITTED",
                "BRANCH_APPROVED",
                "FINANCE_REVIEWED",
                "AUTHORIZED",
                "PAID",
                "REJECTED"
              ]
            },
            "branch_id": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "page": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "per_page": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "submit_disbursement",
        "title": "Submit disbursement",
        "description": "Transition a draft disbursement to SUBMITTED. Enforced server-side: only the original requester in the same branch may submit.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "disbursement_id": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "description": "Disbursement request primary key."
            }
          },
          "required": [
            "disbursement_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "branch_approve_disbursement",
        "title": "Branch-approve disbursement",
        "description": "Branch-manager approval step. Server enforces: same branch as the request AND approver != requester (no self-approval).",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "disbursement_id": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "remarks": {
              "type": "string",
              "maxLength": 1000
            }
          },
          "required": [
            "disbursement_id"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
